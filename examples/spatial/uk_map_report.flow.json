{
  "format": "flowengine.workflow",
  "formatVersion": 1,
  "name": "UK city coverage map report",
  "description": "Trade areas around UK cities coloured by geodesic distance to London, drawn with Report Map and rendered to PDF with a header and footer.",
  "nodes": [
    {
      "id": "cities",
      "tool": "core.input_data",
      "config": {
        "path": "data/uk_cities.csv",
        "type_inference": "flowbench"
      },
      "position": {
        "x": 0,
        "y": 100
      }
    },
    {
      "id": "city_points",
      "tool": "core.create_points",
      "config": {
        "x_field": "Longitude",
        "y_field": "Latitude"
      },
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "london",
      "tool": "core.formula",
      "config": {
        "formulas": [
          {
            "field": "London",
            "expression": "\"POINT (-0.1276 51.5072)\"",
            "type": "v_wstring",
            "size": 40
          }
        ]
      },
      "position": {
        "x": 400,
        "y": 0
      }
    },
    {
      "id": "to_london",
      "tool": "core.distance",
      "config": {
        "source_field": "Point",
        "target_field": "London",
        "units": "km"
      },
      "position": {
        "x": 600,
        "y": 0
      }
    },
    {
      "id": "areas",
      "tool": "core.trade_area",
      "config": {
        "geometry_field": "Point",
        "radii": [
          30
        ],
        "units": "km"
      },
      "position": {
        "x": 800,
        "y": 0
      }
    },
    {
      "id": "map",
      "tool": "core.report_map",
      "config": {
        "title": "UK cities: 30 km areas coloured by distance to London",
        "layers": [
          {
            "geometry_field": "TradeArea",
            "name": "30 km area",
            "theme_field": "Distance",
            "palette": "viridis",
            "opacity": 0.7
          },
          {
            "geometry_field": "Point",
            "name": "City",
            "label_field": "City",
            "color": "#222222",
            "point_size": 3
          }
        ],
        "height": 760
      },
      "position": {
        "x": 1000,
        "y": 0
      }
    },
    {
      "id": "header",
      "tool": "core.report_header",
      "config": {
        "title": "Flowbench spatial report",
        "subtitle": "UK city coverage"
      },
      "position": {
        "x": 1000,
        "y": -120
      }
    },
    {
      "id": "footer",
      "tool": "core.report_footer",
      "config": {
        "left": "Generated by Flowbench",
        "right": "Page {page} of {pages}"
      },
      "position": {
        "x": 1000,
        "y": 120
      }
    },
    {
      "id": "page",
      "tool": "core.report_layout",
      "config": {},
      "position": {
        "x": 1200,
        "y": 0
      }
    },
    {
      "id": "pdf",
      "tool": "core.render",
      "config": {
        "path": "out/uk_map_report.pdf",
        "title": "UK city coverage"
      },
      "position": {
        "x": 1400,
        "y": 0
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "cities",
        "anchor": "output"
      },
      "to": {
        "node": "city_points",
        "anchor": "input"
      }
    },
    {
      "from": {
        "node": "city_points",
        "anchor": "output"
      },
      "to": {
        "node": "london",
        "anchor": "input"
      }
    },
    {
      "from": {
        "node": "london",
        "anchor": "output"
      },
      "to": {
        "node": "to_london",
        "anchor": "input"
      }
    },
    {
      "from": {
        "node": "to_london",
        "anchor": "output"
      },
      "to": {
        "node": "areas",
        "anchor": "input"
      }
    },
    {
      "from": {
        "node": "areas",
        "anchor": "output"
      },
      "to": {
        "node": "map",
        "anchor": "layers"
      }
    },
    {
      "from": {
        "node": "to_london",
        "anchor": "output"
      },
      "to": {
        "node": "map",
        "anchor": "layers"
      }
    },
    {
      "from": {
        "node": "header",
        "anchor": "output"
      },
      "to": {
        "node": "page",
        "anchor": "inputs"
      }
    },
    {
      "from": {
        "node": "map",
        "anchor": "output"
      },
      "to": {
        "node": "page",
        "anchor": "inputs"
      }
    },
    {
      "from": {
        "node": "footer",
        "anchor": "output"
      },
      "to": {
        "node": "page",
        "anchor": "inputs"
      }
    },
    {
      "from": {
        "node": "page",
        "anchor": "output"
      },
      "to": {
        "node": "pdf",
        "anchor": "input"
      }
    }
  ]
}
