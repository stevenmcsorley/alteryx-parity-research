    {
      "id": "filter_1",
      "tool": "core.filter",
      "config": {
        "expression": "[type] = 'earthquake' AND !IsNull([latitude]) AND !IsNull([longitude]) AND [latitude] >= -90 AND [latitude] <= 90 AND [longitude] >= -180 AND [longitude] <= 180 AND !IsEmpty([time])"
      },
      "position": {
        "x": 250,
        "y": 0
      }
    },
    {
      "id": "browse_3",
      "tool": "core.browse",
      "config": {},
