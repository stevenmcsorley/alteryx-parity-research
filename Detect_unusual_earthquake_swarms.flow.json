        "x": 500,
        "y": 180
      }
    },
    {
      "id": "formula_1",
      "tool": "core.formula",
      "config": {
        "formulas": [
          {
            "field": "LatBin",
            "expression": "Floor(([latitude]+90)/2)*2-90",
            "type": "double"
          },
          {
            "field": "LonBin",
            "expression": "Floor(([longitude]+180)/2)*2-180",
            "type": "double"
          },
          {
            "field": "DayUTC",
            "expression": "Left([time],10)",
            "type": "v_wstring",
            "size": 10
          },
          {
            "field": "HourUTC",
            "expression": "Left([time],13)",
            "type": "v_wstring",
            "size": 13
          },
          {
            "field": "DepthClass",
            "expression": "IF IsNull([depth]) THEN 'unknown' ELSEIF [depth] < 0 THEN 'negative' ELSEIF [depth] < 70 THEN 'shallow_0_70' ELSEIF [depth] < 300 THEN 'intermediate_70_300' ELSE 'deep_300plus' ENDIF",
            "type": "v_wstring",
            "size": 30
          },
          {
            "field": "M25",
            "expression": "IF [mag] >= 2.5 THEN 1 ELSE 0 ENDIF",
            "type": "int32"
          },
          {
            "field": "M45",
            "expression": "IF [mag] >= 4.5 THEN 1 ELSE 0 ENDIF",
            "type": "int32"
          }
        ]
      },
      "position": {
        "x": 500,
        "y": 0
      }
    },
    {
      "id": "create_points_1",
