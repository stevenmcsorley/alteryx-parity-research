<?xml version="1.0"?>
<!-- Original fixture authored for this project (synthetic data). Exercises the importer: supported tools,
     a container, a comment, a named multi-input connection and one tool without an implementation. -->
<AlteryxDocument yxmdVer="2026.1">
  <Nodes>
    <Node ToolID="1">
      <GuiSettings Plugin="AlteryxBasePluginsGui.TextInput.TextInput"><Position x="54" y="60" /></GuiSettings>
      <Properties><Configuration><NumRows value="5" /><Fields><Field name="region" /><Field name="units" /><Field name="price" /></Fields>
        <Data><r><c>North</c><c>3</c><c>2.5</c></r><r><c>South</c><c>10</c><c>1.0</c></r><r><c>North</c><c>1</c><c>4.0</c></r>
          <r><c>East</c><c>7</c><c>3.0</c></r><r><c>South</c><c /><c>9.5</c></r></Data></Configuration>
        <Annotation DisableTool="False"><AnnotationText>synthetic sales</AnnotationText></Annotation></Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxTextInput" />
    </Node>
