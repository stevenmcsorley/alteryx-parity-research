{
  "protocol": "flowbench.agent.v1",
  "version": 1,
  "common_error": {
    "type": "object",
    "required": { "tool": "string", "code": "string", "stage": "string", "error": "string" },
    "optional": {},
    "additionalProperties": false
  },
  "contracts": {
    "app.get_status": { "type": "object", "required": { "protocol": "string", "engine": "object", "run": "object" }, "optional": {}, "additionalProperties": false },
    "app.get_capabilities": { "type": "object", "required": { "protocol": "string", "catalogue_entries": "integer", "installed_kernels": "integer", "implemented_catalogue_entries": "integer", "tools": "array" }, "optional": { "tools_truncated": "boolean" }, "additionalProperties": false },
    "app.get_active_workflow": { "type": "object", "required": { "node_count": "integer", "edge_count": "integer" }, "optional": {}, "additionalProperties": false },
    "catalog.search_tools": { "type": "array", "maxItems": 50 },
    "catalog.get_tool_manifest": { "type": "object", "required": { "tool_id": "string", "version": "string", "catalog_ids": "array", "inputs": "array", "outputs": "array", "config_schema": "object" }, "optional": {}, "additionalProperties": false },
    "workflow.get_snapshot": { "type": "object", "required": { "protocol": "string", "base_revision": "string", "nodes": "array", "edges": "array", "problems": "object", "privacy": "string" }, "optional": { "nodes_truncated": "boolean", "edges_truncated": "boolean" }, "additionalProperties": false },
    "workflow.get_schema": { "type": "object", "required": { "node_ref": "string", "anchors": "array" }, "optional": {}, "additionalProperties": false },
    "workflow.get_node_config": { "type": "object", "required": { "node_ref": "string", "kind": "string", "config": "object" }, "optional": { "tool_id": "string" }, "additionalProperties": false },
    "workflow.validate": { "type": "object", "required": { "count": "integer", "problems": "array" }, "optional": {}, "additionalProperties": false },
    "workflow.get_diagnostics": { "type": "object", "required": { "validating": "boolean", "problems": "object", "latest_run": "object" }, "optional": {}, "additionalProperties": false },
    "workflow.propose_patch": { "type": "object", "required": { "status": "string", "operation_count": "integer", "valid": "boolean", "problem_codes": "array" }, "optional": {}, "additionalProperties": false },
    "workflow.request_run": { "type": "object", "required": { "status": "string" }, "optional": { "outputs": "array" }, "additionalProperties": false },
    "workflow.request_save": { "type": "object", "required": { "status": "string", "path_selected": "boolean" }, "optional": {}, "additionalProperties": false },
    "run.get_results": { "type": "object", "required": { "status": "string", "outputs": "array" }, "optional": { "outputs_truncated": "boolean" }, "additionalProperties": false },
    "run.get_result_page": { "type": "object", "required": { "node_ref": "string", "offset": "integer", "total_rows": "integer", "available_rows": "integer", "fields": "array", "fields_truncated": "boolean", "rows": "array" }, "optional": {}, "additionalProperties": false }
  }
}
