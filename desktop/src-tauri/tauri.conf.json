{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowbench",
  "version": "0.5.1",
  "identifier": "org.parityresearch.flowbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Flowbench", "width": 1500, "height": 940, "minWidth": 1100, "minHeight": 700 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../../flowengine/": "engine/flowengine/",
      "../../schemas/": "engine/schemas/",
      "../../data/catalog.json": "engine/data/catalog.json",
      "../../data/tool-status.json": "engine/data/tool-status.json",
      "../../requirements.txt": "engine/requirements.txt",
      "runtime/": "runtime/"
    },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
