  "configuration_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "provider",
      "connection_id",
      "geography_field",
      "variables"
    ],
    "properties": {
      "provider": {
        "type": "string",
        "enum": [
          "us-census-acs"
        ]
      },
      "provider_semantics": {
        "type": "string"
      },
      "connection_id": {
        "type": "string",
        "minLength": 1,
        "x-flowbench-connection": "web",
        "description": "https://api.census.gov/data, Signed URL with key=<your key>"
      },
      "year": {
        "type": "integer",
        "minimum": 2009,
        "maximum": 2100,
        "default": 2023
      },
      "dataset": {
        "enum": [
          "acs/acs5",
          "acs/acs1",
          "acs/acs5/profile",
          "acs/acs5/subject"
        ],
        "default": "acs/acs5"
      },
      "timeout_seconds": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 600,
        "default": 120
      },
      "variables": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,30}$"
        },
        "description": "ACS variable codes, e.g. B01003_001E (total population); see Allocate MetaInfo"
      },
      "geography_field": {
        "type": "string",
        "minLength": 1,
        "description": "Field naming each geography, e.g. NAME"
      },
      "title": {
        "type": "string",
        "default": "Demographic profile"
      }
    }
  },
  "deterministic": false,
  "external_dependencies": [
